# Copy to .env.local and fill in yourself. Never commit real values or paste them into chat.
# Verify with: npm run check:env   (prints names and pass/fail only, never values)

# Public site URL (metadata, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...) is the only key allowed in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Rate limiting needs to know WHICH request header your host's own proxy sets with the real client
# address (it must overwrite any value a client sends). Examples: x-real-ip, cf-connecting-ip,
# x-vercel-forwarded-for. Leave UNSET until the hosting is chosen: nothing is trusted by default, and
# then only the per-account login limit applies (no per-client limit). Never point this at a header
# the host does not overwrite: a client could forge it. See docs/content-needed.md, section 4.
# TRUSTED_PROXY_HEADER=

# The site is noindex (placeholder content). Set to true only after the launch gate is cleared.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Cloudflare Turnstile (public enquiry form). The SITE key is public by design; the SECRET key is
# server-only. Cloudflare publishes dummy keys for local testing (see their Turnstile docs).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). Needed from the lead-intake phase onward; leave unset until then.
# Used in exactly one server module to call public.submit_lead(). Never import it from client code.
# Exactly ONE of the two credentials below will be configured. There is no automatic fallback from
# the first to the second (see docs/lead-intake-credential.md).
#
# Option B (preferred, unverified): connection string of the least-privilege `lead_intake` role via
# the Supabase shared pooler. Copy the host from the dashboard's Connect dialog; the username is
# lead_intake.<project-ref>. Percent-encode special characters in the password.
# LEAD_INTAKE_DATABASE_URL=
#
# Option A (only if Option B is rejected after live testing): the Supabase secret key.
# SUPABASE_SECRET_KEY=

# CRM two-factor (TOTP) policy. Server-side only. Allowed values: off | enrolled | required.
#   enrolled (default when unset): staff who have enrolled a factor must pass it; others can still sign in.
#   required: every staff member must enrol and pass a factor before reaching the CRM.
#   off: no enforcement (local development only).
# Any other value fails closed to "required". Use "required" for production once everyone has enrolled.
# See docs/overnight/MFA.md.
# MFA_MODE=enrolled

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). Enables owner-sent team invitations on /admin/team.
# Set it to a Supabase secret key (Dashboard -> Project Settings -> API). That key can administer ALL
# Auth users, so keep it only in the server host's secret store: never commit it, never expose it to the
# browser, never paste it into chat. Leave UNSET to run the CRM without invitations (the team page then
# says so). Deliberately separate from SUPABASE_SECRET_KEY above, which is the optional lead-intake
# credential and must not be set together with LEAD_INTAKE_DATABASE_URL.
# Setup steps (redirect URL, invite template, SMTP): docs/overnight/TEAM-WORKFLOW.md.
# SUPABASE_TEAM_ADMIN_KEY=
