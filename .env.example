# Copy to .env.local and fill in yourself. Never commit real values or paste them into chat.
# Verify with: npm run check:env   (prints names and pass/fail only, never values)

# Public site URL (metadata, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...) is the only key allowed in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY (no NEXT_PUBLIC_ prefix). Needed from the lead-intake phase onward; leave unset until then.
# Used in exactly one server module to call public.submit_lead(). Never import it from client code.
# Exactly ONE of the two credentials below will be configured. There is no automatic fallback from
# the first to the second (see docs/lead-intake-credential.md).
#
# Option B (preferred, unverified): connection string of the least-privilege `lead_intake` role via
# the Supabase shared pooler. Copy the host from the dashboard's Connect dialog; the username is
# lead_intake.<project-ref>. Percent-encode special characters in the password.
# LEAD_INTAKE_DATABASE_URL=
#
# Option A (only if Option B is rejected after live testing): the Supabase secret key.
# SUPABASE_SECRET_KEY=
